  "main": "hardhat.config.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test test/OptionPool.test.js",
    "test:all": "hardhat test",
    "test:client": "node --test client/src/troveProtect.test.mjs client/src/network.test.mjs client/src/poolRules.test.mjs client/src/instruments.test.mjs client/src/payoff.test.mjs client/src/market.test.mjs client/src/orderForm.test.mjs",
    "deploy:testnet": "hardhat run scripts/deployV2.js --network matsnet",
    "deploy:mainnet": "hardhat run scripts/deployV2.js --network mainnet",
    "health:testnet": "hardhat run scripts/health.js --network matsnet",
    "dapp": "npm start --prefix client",
    "client-install": "npm install --prefix client",
    "fetch:mezo": "./tools/fetch-mezo.sh",
    "test:mezo": "hardhat test test/mezo.integration.test.js",
    "fuzz:setup": "forge install foundry-rs/forge-std@v1.17.0 --no-git",
    "fuzz": "forge test",
    "analyze": "./tools/static-analysis.sh"
  },
  "keywords": [],
