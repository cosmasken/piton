# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
client/node_modules
# testing
/coverage

# production
/build
/artifacts
/cache

# misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*

truffle-config.js

# deployment secrets
.env
brand-picker.html

# internal docs
docs/

# bot scripts (contain wallet keys) — ignored by default; safe, key-free scripts are re-included below
scripts/*
!scripts/lib/
!scripts/ivKeeper.js
!scripts/autoExercise.js
!scripts/deployV2.js
!scripts/seedV2.js
!scripts/health.js

# Mezo protocol contracts fetched by tools/fetch-mezo.sh (GPL-3.0, not vendored)
/contracts/mezo
/deployments/localhost.json
/deployments/hardhat.json

# static-analysis raw output (regenerate with tools/static-analysis.sh)
/audit/out

# Foundry (fuzz/invariant tests): build output and forge-std (npm run fuzz:setup)
/out-forge
/cache-forge
/lib

# client build output (regenerate with: npm run build --prefix client)
/client/dist
